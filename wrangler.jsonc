{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "site-kari",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Tudo passa pelo Worker, para os cabeçalhos de segurança valerem também nos arquivos estáticos (painel, CSS, fontes).
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "site-kari",
      "database_id": "da3b4b64-0da2-431a-be4d-6221bf9c450d",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "FOTOS", "bucket_name": "site-kari-fotos" }
  ],
  // Só envia para endereços verificados no Email Routing do domínio (a Kari e o Caio).
  "send_email": [
    { "name": "EMAIL" }
  ],
  "triggers": {
    // Toda segunda às 9h UTC: renova os tokens do Instagram.
    "crons": ["0 9 * * 1"]
  },
  "vars": {
    "EMAILS_PERMITIDOS": "",
    "REMETENTE": "",
    "WHATSAPP": "https://wa.me/message/X6FXMZWUW2EKM1",
    "MODO_INSTAGRAM": "real"
  }
  // Segredos (wrangler secret put): SEGREDO_SESSAO, IG_APP_ID, IG_APP_SECRET
}
