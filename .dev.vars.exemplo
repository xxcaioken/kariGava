DEV_LOGIN=1
# Token do Cloudflare Web Analytics (vars.ANALYTICS_TOKEN): com ele o site inclui o beacon sem cookies; o painel nunca.
# O e2e de R-11 lê esta variável de .dev.vars e é pulado se ela faltar.
ANALYTICS_TOKEN=abc
SEGREDO_SESSAO=segredo-local-so-para-desenvolvimento-123
EMAILS_PERMITIDOS=kari@exemplo.com,caio@exemplo.com
MODO_INSTAGRAM=falso
# O número do WhatsApp vem de vars.WHATSAPP_NUMERO no wrangler.jsonc; para testar outro número localmente:
# WHATSAPP_NUMERO=5548998459412
# E-mail de contato da página /privacidade (vars.EMAIL_CONTATO no wrangler.jsonc); vazio, a página cita o WhatsApp.
# EMAIL_CONTATO=kari@exemplo.com
# Endereço final do site para canonical/og:url/sitemap (vars.SITE_URL); vazio, usa o endereço do request.
# SITE_URL=https://karigava.com.br
# Para depurar bloqueios da CSP, descomente: o navegador só avisa no console em vez de bloquear.
# CSP_MODO=relatorio
